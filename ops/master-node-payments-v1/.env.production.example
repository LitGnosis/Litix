# Litix first-party master-node staging template (non-secret example only)
# Never deploy this template as a real production .env file.
# Install actual values through protected Vercel and dedicated-worker secret managers.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://litix.net

# Approved, privately provisioned database and worker service endpoints
DATABASE_URL=
REDIS_URL=

# Verified live merchant webhook identifiers and signing secrets
NMI_MERCHANT_ID=
NMI_MERCHANT_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# Approved backend-owned service enablement only. Start closed.
LITIX_PAYMENT_WEBHOOK_ENABLED=false
LITIX_OWNED_DISPATCH_ENABLED=false
LITIX_OPS_TERMINAL_ENABLED=false
LITIX_OWNED_PROXY_AUDIT_ENABLED=false

# Signed owner identity, internal cron and secure authorized network probe
LITIX_OPS_SESSION_SECRET=
CRON_SECRET=
LITIX_OWNED_EGRESS_PROBE_URL=https://www.litix.net/api/fulfillment/health
LITIX_PROXY_SECRET_MAP_JSON={}

# No PAYKINGS_API_KEY or LITIX_MASTER_JWT_SECRET values are included.
# Do not copy customer payment secrets or social account credentials into Git.
