# Never commit actual values. Copy to /etc/litix/reliability.env (root:litix, mode 0640).
# Source of truth: managed Neon PostgreSQL + managed Redis reachable from dedicated Linux worker.
# Do not use 127.0.0.1 unless Redis/Postgres are genuinely deployed and firewalled on that same worker host.
DATABASE_URL=
REDIS_URL=
LITIX_TELEMETRY_SIGNING_SECRET=
LITIX_OWNED_TELEMETRY_ENABLED=false
LITIX_OWNED_WEBHOOKS_ENABLED=false

# Explicit operator-approved webhook destinations only. Keep signing keys secret.
LITIX_WEBHOOK_ALLOWED_HOSTS=
LITIX_WEBHOOK_ENDPOINT_CONFIG_JSON={}
