{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --no-audit --no-fund",
  "crons": [
    {
      "path": "/api/v2/cron/sync-catalog",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/bundles/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/guardian/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/boostero/cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/autolikes/cron",
      "schedule": "5,20,35,50 * * * *"
    }
  ]
}
