{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --no-audit --no-fund",
  "crons": [
    {
      "path": "/api/bundles/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/guardian/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/boostero/cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/internal/boostero/inventory-sync",
      "schedule": "0 */6 * * *"
    }
  ]
}
