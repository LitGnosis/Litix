{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --no-audit --no-fund",
  "crons": [
    {
      "path": "/api/bundles/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/guardian/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/boostero/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/autolikes/cron",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/autolikes/prepaid/cron",
      "schedule": "7,22,37,52 * * * *"
    },
    {
      "path": "/api/checkout/settlement/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-orders",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/sync-services",
      "schedule": "10 3 * * *"
    }
  ]
}
